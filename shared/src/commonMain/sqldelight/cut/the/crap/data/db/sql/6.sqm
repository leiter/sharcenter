-- v6 -> v7 : adds action reminders (doc/ACTION_REMINDER_SPEC.md §3)
CREATE TABLE IF NOT EXISTS action_reminders_table (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    campaignId TEXT NOT NULL,
    countryCode TEXT NOT NULL,
    language TEXT NOT NULL,
    postToX INTEGER NOT NULL,
    postToFacebook INTEGER NOT NULL,
    scheduleType TEXT NOT NULL,
    daysOfWeek INTEGER NOT NULL DEFAULT 0,
    onceDate TEXT,
    windowStartMinute INTEGER NOT NULL,
    windowEndMinute INTEGER NOT NULL,
    postsJson TEXT NOT NULL,
    campaignVersion INTEGER NOT NULL,
    nextPostIndex INTEGER NOT NULL DEFAULT 0,
    enabled INTEGER NOT NULL DEFAULT 1,
    lastFiredAt INTEGER,
    createdAt INTEGER NOT NULL,
    modifiedAt INTEGER NOT NULL
);
