<resources>
    <!--
      The app's string catalogue lives in :shared/commonMain/composeResources/values/strings.xml
      and is reached from Compose via `Res.string.*`.

      `app_name` is the one exception: it is the manifest's android:label, which AAPT resolves
      at build time and which therefore cannot come from a Compose resource. It is duplicated
      here deliberately — keep the two in sync if the app is ever renamed.
    -->
    <string name="app_name">ShareCenter</string>
</resources>
