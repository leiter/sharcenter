<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Same App Group as the Share Extension, so the app can read the inbox the extension writes.
         Must match ShareExtension.entitlements and APP_GROUP_ID in ShareInbox.kt. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.cut.the.crap</string>
    </array>
</dict>
</plist>
