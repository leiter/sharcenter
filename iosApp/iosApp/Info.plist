<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>ShareCenter</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- IosFileAccess.saveToDownloads writes exports into the app's Documents directory (iOS has
         no Downloads folder). These two keys are what actually make that directory reachable:
         UIFileSharingEnabled exposes it in the Files app under "On My iPhone > ShareCenter", and
         LSSupportsOpeningDocumentsInPlace lets Files open/edit those exports in place rather than
         handing out a copy. Without both, an export "succeeds" into a sandbox the user cannot
         browse. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <!-- Required by Compose Multiplatform: without it, its startup PlistSanityCheck throws.
         Lets Compose drive the display at its full refresh rate (e.g. 120Hz ProMotion). -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- The dev job-queue server is a plain-http:// address on the LAN, which iOS App Transport
         Security blocks by default. NSAllowsLocalNetworking permits cleartext to local/reserved
         addresses (loopback, .local, and private ranges like 192.168.x.x) WITHOUT the blanket
         NSAllowsArbitraryLoads hole that would also allow cleartext to the whole internet — and
         which is an App Store review flag. A production https:// endpoint needs neither key. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
